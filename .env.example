# Set to 1 for zero API keys / golden responses
DEMO_MODE=1

# OpenAI-compatible API (optional when DEMO_MODE=0)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Frontend API Base URL (optional for production static deployment; defaults to /api for local dev proxy)
VITE_API_BASE_URL=
